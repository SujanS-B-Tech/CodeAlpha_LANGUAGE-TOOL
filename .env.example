# ==============================================================================
# LinguaBridge - Environment Configuration Template
# Copy this file to '.env' and populate with your Google Cloud credentials.
# NEVER commit your actual '.env' file to version control!
# ==============================================================================

# Option 1: Google Cloud Translation API Key (Recommended for simplicity)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> API key
GOOGLE_TRANSLATE_API_KEY=your_google_cloud_api_key_here

# Option 2: Path to Google Service Account JSON Key (Alternative enterprise auth)
# Example: GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service_account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: Custom API Request Timeout in seconds (default is 10)
TRANSLATION_TIMEOUT_SECONDS=10
